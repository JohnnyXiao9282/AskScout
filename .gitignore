# ============================================================
# Secrets: never commit these
# ============================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
.secrets/

# ============================================================
# User data: uploaded documents (may be personal or copyrighted)
# ============================================================
server/uploads/*
!server/uploads/.gitkeep

# ============================================================
# Node / React (Create React App)
# ============================================================
node_modules/
/.pnp
.pnp.js
.yarn/
/build
/coverage
.eslintcache
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ============================================================
# Logs and temp files
# ============================================================
logs/
*.log
*.tmp
*.swp
*.swo
*~

